# OSS platform: current production build supports only r2
OSS_PLATFORM=r2

# Cloudflare R2
R2_ACCOUNT_ID=replace_with_r2_account_id
R2_ACCESS_KEY_ID=replace_with_r2_access_key_id
R2_SECRET_ACCESS_KEY=replace_with_r2_secret_access_key
R2_BUCKET_NAME=replace_with_r2_bucket_name
R2_REGION=auto
R2_CUSTOM_DOMAIN=replace_with_r2_custom_domain

# Optional placeholders kept for compose compatibility
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_BUCKET_NAME=
