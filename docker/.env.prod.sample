IMAGE_TAG=replace_with_release_tag
APP_ENV=prod

# Database
POSTGRES_PASSWORD=replace_with_database_password
DATABASE_USER=poprako_s
DATABASE_NAME=db_poprako_s
DATABASE_PASSWORD=replace_with_database_password
DATABASE_HOST=prod-postgres
DATABASE_PORT=5432

# JWT
JWT_SECRET=replace_with_jwt_secret
